# TaxMate API — environment placeholders ONLY. Copy to .env and fill in
# real values. NEVER commit a real .env file, and never put credentials
# in code. The repo's starter config/database.php is untouched by the API;
# the API reads these variables, not that starter config.
DB_HOST=localhost
DB_NAME=taxmate
DB_USER=your_db_user
DB_PASS=your_db_password
# Optional: public base URL of this API, for the Flutter app's config only.
# Do not put a real production URL here unless this file is only an example.
API_BASE_URL=http://localhost/taxmate-backend/api
